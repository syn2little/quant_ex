# ============================================================
# Project: Generated / Cache
# ============================================================
# Cache policy:
# - default: ignore everything under cache/
# - allow-list only the durable cache artifacts we intentionally version:
#   cache/financial/*.csv, cache/northbound/*.csv and cache/sector_map.json
cache/**
!cache/
!cache/financial/
!cache/financial/*.csv
!cache/northbound/
!cache/northbound/*.csv
!cache/sector_map.json

